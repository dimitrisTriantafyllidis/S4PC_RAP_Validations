@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Billing Validation',
  typeNamePlural: 'Billing Validation',
  title: { value: 'Description' }
}
annotate view ZC_BilValConfig with
{
  @UI.facet: [
    { id: 'Rules', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Rules', position: 10, targetElement: '_Rule' },
    { id: 'Plugins', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Plug-ins', position: 20, targetElement: '_Plugin' }
  ]
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  ConfigId;
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Description;
  @UI.hidden: true
  LocalLastChangedBy;
  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  LastChangedAt;
}
