@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Rule',
  typeNamePlural: 'Rules',
  title: { type: #STANDARD, value: 'RuleId' },
  description: { type: #STANDARD, value: 'Description' }
}
annotate view ZC_BilValRule with
{
  @UI.facet: [
    {
      id: 'Rule',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Rule',
      position: 10
    },
    {
      id: 'Conditions',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Conditions',
      position: 20,
      targetElement: '_Condition'
    }
  ]
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  RuleId;

  @UI.hidden: true
  ConfigId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Description;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @Consumption.valueHelpDefinition: [{
    entity: { name: 'ZI_BilValCodeVH', element: 'Code' },
    additionalBinding: [{ element: 'CodeGroup', localConstant: 'CHECKPOINT', usage: #FILTER }]
  }]
  Checkpoint;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @Consumption.valueHelpDefinition: [{
    entity: { name: 'ZI_BilValCodeVH', element: 'Code' },
    additionalBinding: [{ element: 'CodeGroup', localConstant: 'OUTCOME', usage: #FILTER }]
  }]
  Outcome;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  @Consumption.valueHelpDefinition: [{
    entity: { name: 'ZI_BilValCodeVH', element: 'Code' },
    additionalBinding: [{ element: 'CodeGroup', localConstant: 'SEVERITY', usage: #FILTER }]
  }]
  Severity;

  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  BillingType;

  @UI.identification: [{ position: 70 }]
  SalesOrganization;

  @UI.identification: [{ position: 80 }]
  CompanyCode;

  @UI.identification: [{ position: 90 }]
  ItemCategory;

  @UI.identification: [{ position: 100 }]
  SoldToParty;

  @UI.lineItem: [{ position: 70 }]
  @UI.identification: [{ position: 110 }]
  MessageText;

  @UI.lineItem: [{ position: 80 }]
  @UI.identification: [{ position: 120 }]
  ActiveFlag;

  @UI.lineItem: [{ position: 90 }]
  @UI.identification: [{ position: 130 }]
  Sequence;

  @UI.identification: [{ position: 140 }]
  ApprovalReason;

  @UI.hidden: true
